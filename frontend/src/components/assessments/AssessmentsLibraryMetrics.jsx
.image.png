import React from 'react';
import { FileQuestion, Clock, Target } from 'lucide-react';

/** Secondary library-average metrics from analytics headline. */
export default function AssessmentsLibraryMetrics({ headline }) {
  if (!headline) return null;
  const hasAny =
    headline.avg_questions_per_assessment != null ||
    headline.avg_duration_minutes != null ||
    headline.pass_threshold_pct != null;
  if (!hasAny) return null;

  const items = [
    {
      label: 'Avg questions',
      value: headline.avg_questions_per_assessment != null ? headline.avg_questions_per_assessment : '',
      icon: FileQuestion,
    },
    {
      label: 'Avg duration',
      value: headline.avg_duration_minutes != null ? `${headline.avg_duration_minutes} min` : '',
      icon: Clock,
    },
    {
      label: 'Avg pass threshold',
      value: headline.pass_threshold_pct != null ? `${headline.pass_threshold_pct}%` : '',
      icon: Target,
    },
  ];

  return (
    <motion.div className="grid grid-cols-1 sm:grid-cols-3 gap-3" data-testid="assessments-library-metrics">
      {items.map(({ label, value, icon: Icon }) => (
        <div
          key={label}
          className="flex items-center gap-3 rounded-lg border border-slate-100 bg-white px-4 py-3 text-sm"
        >
          <div className="w-9 h-9 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
            <Icon className="w-4 h-4 text-slate-600" />
          </div>
          <div>
            <p className="text-xs text-slate-500">{label}</p>
            <p className="font-semibold text-slate-900">{value}</p>
          </div>
        </div>
      ))}
    </div>
  );
}
