# Copy to `.env` in this same folder (repo root, next to docker-compose.yml).
# Docker Compose loads this file automatically. It does NOT load backend/.env into containers.

JWT_SECRET=change-me-long-random-string

# QA admin user (synced on every API boot via seed_qa_baseline.py)
QA_SEED_ADMIN_EMAIL=aghoreshwar@hotmail.com
QA_SEED_ADMIN_PASSWORD=Prince@1804
EMERGENT_LLM_KEY=
OPENAI_API_KEY=

# Hugging Face Inference API (optional; used when HF path is selected in code)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Mistral AI — preferred for Generate Assessment (POST /api/assessments/generate/{job_id})
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# LCD50 demo seed: 1 = wipe LCD50 + full re-seed when demo seeds run
LCD50_SEED_REPLACE=0
LCD50_SKIP_CROSS=0
LCD50_FORCE_CROSS_SYNC=0

# Docker demo bootstrap (api entrypoint): seeds run once per Mongo volume unless forced
DEMO_SEEDS_FORCE=0
SKIP_DEMO_SEEDS=0

# Admin UI: allow flush-all-data (set 0 in production unless explicitly needed)
ALLOW_DB_FLUSH=1

# Excel workbooks at repo root are mounted into the api container and imported on each start (idempotent)
AUTO_IMPORT_EXCEL=1
# CANDIDATES_EXCEL_PATH=/data/excel/Candidates 1.xlsx
# EXCEL_PATH=/data/excel/Job Descriptions 1.xlsx

# Smart Hiring-only product slice (default on for this repo). Set to 0/false to enable all HRMS modules.
SMART_HIRING_ONLY=1
# REACT_APP_SMART_HIRING_ONLY=1

# Smart Hiring Dashboard v2 (frontend build-time; set in frontend/.env or docker-compose web build args)
# REACT_APP_HIRING_DASHBOARD_V2=1

# Alert thresholds (backend)
# HIRING_STAGE_SLA_DAYS_JSON={"SCREENING":14,"ASSESSMENT_SENT":10,"INTERVIEW_1":21}
# HIRING_LOW_FIT_THRESHOLD=50
# HIRING_STUCK_CRITICAL_COUNT=25
# HIRING_MONTHLY_HIRE_TARGET=10
# HIRING_PACK_PERF_BUDGET_SEC=0.8
# HIRING_PACK_SLOW_QUERY_SEC=1.0

# Trend snapshots (backend cron + optional boot hook; docker-compose defaults ON_BOOT=1 + hiring-snapshot-cron sidecar)
# HIRING_SNAPSHOT_TOKEN=docker_dev_hiring_snapshot_token
# HIRING_SNAPSHOT_ON_BOOT=1
# HIRING_SNAPSHOT_INTERVAL_SECONDS=86400
# HIRING_SNAPSHOT_URL=http://127.0.0.1:8000/api/admin/hiring-dashboard/snapshot-cron
# Optional LLM-enhanced hero insights (also toggled in Admin → Hiring Dashboard Config)
# HIRING_DASHBOARD_LLM_INSIGHTS=1
# CANDIDATE_IMPORT_CLEANUP_TOKEN=docker_dev_hiring_snapshot_token
# CANDIDATE_IMPORT_CLEANUP_INTERVAL_SECONDS=86400

# Apify LinkedIn search + enrich (Find Matches). Get token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# APIFY_LINKEDIN_PROCESS_TOKEN=docker_dev_hiring_snapshot_token
# APIFY_LINKEDIN_PROCESS_INTERVAL_SECONDS=60

# --- Smart Hiring assessments (backend + cron) ---
# Public URL candidates use for take links (no trailing slash)
# ASSESSMENT_PUBLIC_BASE_URL=https://hrms.example.com
# Feature toggles (default on when unset): ASSESSMENT_COMMAND_CENTER, ASSESSMENT_PUBLIC_TAKE,
# ASSESSMENT_AI_GRADING, ASSESSMENT_AUTO_CLEAR_PIPELINE, ASSESSMENT_REMINDER_EMAILS,
# ASSESSMENT_OUTCOME_ANALYTICS, ASSESSMENT_COVERAGE_HEATMAP

# SMTP for assessment invite / reminder emails (if unset, emails are queued only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hrms-noreply@example.com
# SMTP_TLS=1

# GitHub Actions / external cron: POST dispatch-invite-emails + dispatch-reminders
# ASSESSMENT_EMAIL_CRON_TOKEN=change-me-long-random-string
# ASSESSMENT_EMAIL_BASE_URL=https://api.example.com/api
# Optional: run invite dispatch once when API container starts (docker-entrypoint.sh)
# ASSESSMENT_EMAIL_ON_BOOT=0
# Validate ops config: python scripts/validate_assessment_ops.py [--strict]
