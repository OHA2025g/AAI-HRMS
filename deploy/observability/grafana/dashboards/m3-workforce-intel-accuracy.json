      "targets": [{ "expr": "aai_m3_workforce_intel_heuristic_mae{job=\"aai-hrms-api\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Model beats heuristic (1=yes)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "aai_m3_workforce_intel_model_beats_heuristic{job=\"aai-hrms-api\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Last MAPE %",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
