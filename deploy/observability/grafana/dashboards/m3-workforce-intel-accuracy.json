    {
      "type": "timeseries",
      "title": "MAE — model vs heuristic",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "aai_m3_workforce_intel_model_mae{job=\"aai-hrms-api\"}",
